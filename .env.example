NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only - bypasses RLS. Never put this in the front end. Needed by the payments, refunds,
# webhook and analytics API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the static front end is served from (comma separated). Required for browser calls to /api/*.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_CALLBACK_TOKEN=your-webhook-callback-token

GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=path/to/service-account.json
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key

GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your-client-id
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your-client-secret
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://homesure.ph
