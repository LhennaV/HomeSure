NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only - bypasses RLS. Never put this in the front end. Needed by the payments, refunds,
# webhook and analytics API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the static front end is served from (comma separated). Required for browser calls to /api/*.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

XENDIT_SECRET_KEY=your-xendit-secret-key
XENDIT_CALLBACK_TOKEN=your-webhook-callback-token

GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=path/to/service-account.json
GOOGLE_CLOUD_VISION_API_KEY=your-vision-api-key

GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your-client-id
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your-client-secret
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://homesure.ph

# ── Sending email ────────────────────────────────────────────────────────────
# HomeSure sends its own confirmation emails. The Supabase auth server insists on a confirmed
# email but has no mail sender configured, and that server is not ours to change — so signing up
# goes through /api/auth/signup, which mails the link from here instead.
#
# Any SMTP provider works. Brevo is the easy one: free, 300 emails a day, and it does not need you
# to own a domain — you just confirm the sender address.
#   Brevo  -> smtp-relay.brevo.com : 587, user is the login shown under SMTP & API
#   Gmail  -> smtp.gmail.com       : 587, user is your address, password is an App Password
# Without these five, /api/auth/signup answers 503 and says so rather than half-creating accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HomeSure <no-reply@homesure.ph>"

# The address the confirmation link points back to. Leave blank on localhost and the request's own
# host is used; set it once the app is deployed somewhere.
APP_ORIGIN=
